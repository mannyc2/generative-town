GOOGLE_GENERATIVE_AI_API_KEY=your-api-key-here

# Optional spritesheet image backend.
# IMAGE_PROVIDER=gemini
# IMAGE_PROVIDER=ideogram

# Hosted Ideogram 4:
# IDEOGRAM_MODE=api
# IDEOGRAM_API_KEY=your-ideogram-api-key

# Local Ideogram 4:
# IDEOGRAM_MODE=local
# IDEOGRAM_LOCAL_COMMAND=python
# IDEOGRAM_LOCAL_SCRIPT=/path/to/ideogram4/run_inference.py
# IDEOGRAM_LOCAL_QUANTIZATION=nf4
# IDEOGRAM_LOCAL_SAMPLER_PRESET=V4_QUALITY_48
